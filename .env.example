# Copiá este archivo como ".env" (con el punto) en la raíz del proyecto y completá los valores.
# El archivo .env NUNCA se sube a Git. Acá solo van ejemplos: no escribas claves reales.

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# Base de datos: sqlite (solo desarrollo local) o mysql
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nombre_de_la_base
DB_USER=usuario_de_la_base
DB_PASS=clave_de_la_base

# Sesiones: dejar vacío en local; en Vercel usar: database
SESSION_DRIVER=

# Administrador inicial (solo se usa si la base no tiene ninguno)
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=

# Notificaciones (API externa api-alertas)
ALERTAS_API_KEY=
